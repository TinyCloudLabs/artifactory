{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["audienceRole", "priorities", "followUps"],
  "properties": {
    "audienceRole": { "type": "string", "minLength": 1 },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["development", "implication", "confidence", "evidenceSourceIds"],
        "properties": {
          "development": { "type": "string", "minLength": 1 },
          "implication": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "evidenceSourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "followUps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
