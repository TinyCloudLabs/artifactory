{
  "schemaVersion": "feed.starter_workflow.v1",
  "workflowId": "feed-daily-brief",
  "format": "daily_brief",
  "trigger": {
    "kind": "scheduled",
    "cadence": "daily"
  },
  "sourcePolicy": {
    "window": "since_previous_success",
    "quietResult": "zero_artifacts"
  },
  "continuity": {
    "keyTemplate": "{actorId}:feed-daily-brief:{audienceRole}",
    "cursor": "listen_started_at_conversation_id",
    "usesPriorArtifacts": true
  },
  "feedPostContract": {
    "minPosts": 1,
    "maxPosts": 5,
    "distinctBodies": true,
    "evidencePerPost": true,
    "sectionTargetPerPost": true
  },
  "stages": [
    {
      "stageId": "stub",
      "capabilities": [],
      "authority": "none",
      "egressClass": "none",
      "spendClass": "none"
    }
  ]
}
